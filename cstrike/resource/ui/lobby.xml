<?xml version="1.0" encoding="utf-8"?>
<!--
  Room lobby. Same box as the room list in main.xml: both team lists, game mode,
  map list and room settings. Host-only controls follow the lobby_ishost cvar.
  Logic lives in LobbyMenu.cpp (lobby.* commands, lobby-team / lobby-maps / lobby-sync).
-->
<menu>
	<include src="resource/ui/theme.xml"/>
	<on event="show" do="set:cl_lobby_zoom=0"/>
	<define name="xp-max" value="1500"/>

	<on event="init" do="call:lobby.init"/>

	<!-- redraws host-only controls when lobby_ishost changes -->
	<lobby-sync/>

	<!-- top bar -->
	<rect x="0" y="0" w="-1" h="38" fill="${c-top}"/>
	<label text="${game-title}" x="14" y="6" w="260" h="26" align="left" color="${c-text}"/>
	<label text="Room Lobby" x="280" y="10" w="240" h="18" align="left" charsize="small" color="${c-dim}"/>

	<!-- room panel -->
	<panel x="-796" y="50" w="780" h="656">
		<rect x="0" y="0" w="780" h="656" fill="${c-panel}" border="${c-line}"/>
		<value cvar="hostname" default="Room" x="14" y="10" w="480" h="20" align="left" charsize="small" color="${c-text}"/>
		<value cvar="lobby_n" default="0" format="Players   {}" x="560" y="10" w="212" h="20" align="right" charsize="small" color="${c-dim}"/>

		<!-- teams; clicking a list moves you to that team -->
		<lobby-team mode="1" title="RED TEAM"  x="8"   y="40" w="378" h="300" charsize="small"/>
		<lobby-team mode="2" title="BLUE TEAM" x="394" y="40" w="378" h="300" charsize="small"/>

		<!-- game mode -->
		<label text="Mode" x="8" y="352" w="80" h="24" align="left" charsize="small" color="${c-dim}" visible-if="cvar:lobby_ishost"/>
		<spin tag="mode" options="Bomb Mission / Elimination,Team Deathmatch,Team Deathmatch Sniper,Team Deathmatch Shotgun,Team Deathmatch Knife"
		      x="90" y="348" w="682" h="28" charsize="small" visible-if="cvar:lobby_ishost"/>

		<!-- map selection -->
		<lobby-maps tag="maps" x="8" y="388" w="380" h="210" charsize="small" visible-if="cvar:lobby_ishost"/>

		<!-- room settings -->
		<label text="BOT Quota" x="400" y="392" w="120" h="24" align="left" charsize="small" color="${c-dim}" visible-if="cvar:lobby_ishost"/>
		<field cvar="bot_quota" max-length="3" numbers-only="true" immediate="true" onchange="call:lobby.bots"
		       x="524" y="388" w="100" h="28" charsize="small" visible-if="cvar:lobby_ishost"/>
		<label text="Title" x="400" y="432" w="120" h="24" align="left" charsize="small" color="${c-dim}" visible-if="cvar:lobby_ishost"/>
		<field cvar="hostname" max-length="32" immediate="true" onchange="call:lobby.rename"
		       x="524" y="428" w="248" h="28" charsize="small" visible-if="cvar:lobby_ishost"/>

		<!-- actions -->
		<tile align="center" text="START GAME" x="8" y="604" w="250" h="44" fill="${c-accent}" hover-fill="${c-hover}"
		      border="${c-hover}" enabled-if="cvar:lobby_ishost" onclick="call:lobby.start"/>
		<tile align="center" text="Leave" x="-136" y="608" w="128" h="40" charsize="small" onclick="call:lobby.leave"/>
	</panel>

	<!-- bottom bar, same as the main menu -->
	<rect x="0" y="-52" w="-1" h="52" fill="${c-top}"/>

	<rect x="10" y="-46" w="400" h="40" fill="${c-panel}" border="${c-line}"/>
<value cvar="cs_acc_user" default="Player" x="18" y="-44" w="384" h="16" align="left" charsize="small" color="${c-text}"/>
<label text="EXP" x="18" y="-26" w="30" h="12" align="left" charsize="small" color="${c-dim}"/>
<bar cvar="cs_acc_xp" max="${xp-max}" x="50" y="-24" w="150" h="10"/>
<value cvar="cs_acc_xp" default="0" max="${xp-max}" format="{}/{max} ({pct}%)"
       x="206" y="-27" w="196" h="14" align="left" charsize="small" color="${c-dim}"/>
<value cvar="cs_acc_points" default="0" format="Point   {}" thousands="true"
       x="430" y="-38" w="240" h="22" align="left" charsize="small" color="${c-text}"/>

	<image src="gfx/vgui/menu/bar_shop.png" focus-src="gfx/vgui/menu/bar_shop_f.png" press-src="gfx/vgui/menu/bar_shop_p.png" x="-208" y="-48" w="44" h="44" notify="true" onclick="menu:shop"/>
	<image src="gfx/vgui/menu/bar_loadout.png" focus-src="gfx/vgui/menu/bar_loadout_f.png" press-src="gfx/vgui/menu/bar_loadout_p.png" x="-156" y="-48" w="44" h="44" notify="true" onclick="menu:loadout"/>
	<image src="gfx/vgui/menu/bar_settings.png" focus-src="gfx/vgui/menu/bar_settings_f.png" press-src="gfx/vgui/menu/bar_settings_p.png" x="-104" y="-48" w="44" h="44" notify="true" onclick="menu:options"/>
	<image src="gfx/vgui/menu/bar_quit.png" focus-src="gfx/vgui/menu/bar_quit_f.png" press-src="gfx/vgui/menu/bar_quit_p.png" x="-52" y="-48" w="44" h="44" notify="true" onclick="dialog:quit"/>
	
	<messagebox id="quit" yes="cmd:quit">
		<text when="singleplayer-game">@IDS_MAIN_QUITPROMPTINGAME</text>
		<text>@IDS_MAIN_QUITPROMPT</text>
	</messagebox>
</menu>
